# Copy to .env.local and fill it in: `npm run setup` reads .env.local to configure and deploy the bot. Never commit real values.

# --- Required ---
# Bot token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# API key from the Soniox console (https://console.soniox.com).
SONIOX_API_KEY=

# --- Generated by setup ---
# Random secret that authenticates requests from Telegram; `npm run setup` generates it.
TELEGRAM_WEBHOOK_SECRET=
# Random secret that authenticates requests from Soniox; `npm run setup` generates it.
SONIOX_WEBHOOK_SECRET=

# --- Access ---
# Comma-separated numeric Telegram user IDs allowed to use the bot; `npm run setup` fills it in.
# Any non-empty value locks the bot; an entry that is not a number is ignored and setup reports it.
ALLOWED_USER_IDS=
# Set to true to make the bot public on purpose (no warning is shown).
# ALLOW_ALL_USERS=true

# --- Summary ---
# OpenAI API key; setting it enables the summary button.
# OPENAI_API_KEY=
# OpenAI model used for summaries; defaults to the current lean model.
# The model must support Chat Completions with reasoning_effort; the default is the verified one.
# OPENAI_MODEL=

# --- Tuning ---
# Bot language: he (default) or en.
# BOT_LANGUAGE=he
# Time zone for the transcript file name (IANA name); defaults to Asia/Jerusalem for he, UTC for en.
# BOT_TIMEZONE=Asia/Jerusalem
# Soniox language hints, comma-separated; defaults to he,en.
# LANGUAGE_HINTS=he,en
# Soniox model name; defaults to stt-async-v5.
# SONIOX_MODEL=stt-async-v5
# Names and terms that improve recognition accuracy.
# SONIOX_CONTEXT=
# Custom https domain for both webhooks. Otherwise Telegram gets the Vercel production domain,
# and Soniox's webhook goes to the same host Telegram calls.
# PUBLIC_BASE_URL=
